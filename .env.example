# Nocturne local server
# 0.0.0.0 lets the server answer this PC and your local network. LAN devices are
# still refused until you enable Settings -> Network -> Watch from another screen.
# Set 127.0.0.1 here to force local-only; the LAN toggle cannot work in that mode.
PORT=8787
HOST=0.0.0.0

# Advanced / optional fallback:
# The normal setup screen handles Plex sign-in and writes data/config.json.
# You can skip the setup screen by providing a token here instead.
# PLEX_TOKEN=
# PLEX_URL=http://127.0.0.1:32400

# Optional: open a specific Plex Web address when playback is launched.
# PLEX_WEB_BASE_URL=http://127.0.0.1:32400/web

# Optional, for automated testing only. Normally https://plex.tv
# PLEX_TV_BASE_URL=
